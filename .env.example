# ── Database (docker-compose) ──────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finance_db

# ── Backend (apps/api) — copy to apps/api/.env ────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_db"

JWT_SECRET_KEY=                  # openssl rand -base64 32
JWT_REFRESH_SECRET_KEY=          # openssl rand -base64 32

ROOT_ADMIN_EMAIL=admin@example.com
ROOT_ADMIN_PASSWORD=

ACCESS_TOKEN_VALIDITY_DURATION_IN_SEC=900
REFRESH_TOKEN_VALIDITY_DURATION_IN_SEC=604800

MAIL_HOST=localhost
MAIL_PORT=1025
APP_URL=http://localhost:5173

# ── Frontend (apps/web) — copy to apps/web/.env ───────────────────────────────
VITE_API_BASE_URL=http://localhost:3000
VITE_BACKEND_TYPE=nestjs
VITE_APP_NAME=MyFinance
