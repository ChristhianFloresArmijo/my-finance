COMPOSE_PROJECT_NAME=nest-ddd-template

# =================================================================
# NestJS + Prisma Backend Template - Environment Configuration
# =================================================================


# Node Environment
# development | production
NODE_ENV=development

# =================================================================
# DATABASE CONFIGURATION
# =================================================================

# Docker PostgreSQL Configuration
POSTGRES_VERSION=16.2
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# =================================================================
# JWT AUTHENTICATION
# =================================================================
JWT_SECRET_KEY="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET_KEY="your-super-secret-refresh-key-change-this-in-production"
# 15 minutes in seconds
ACCESS_TOKEN_VALIDITY_DURATION_IN_SEC=900
# Refresh token expiration
SECRET_KEY_EXPIRES_IN="60 days"

# =================================================================
# ROOT ADMIN USER (Created on first seed)
# =================================================================
ROOT_ADMIN_EMAIL="admin@admin.com"
ROOT_ADMIN_PASSWORD="DevAdmin123!"
ROOT_ADMIN_FIRST_NAME="Root"
ROOT_ADMIN_LAST_NAME="Administrator"
# Role name (not ID) auto-assigned on sign-up when role_ids is not sent.
# Must match an existing role's `name` field in the DB. Leave empty to skip.
DEFAULT_SIGNUP_ROLE=client

# =================================================================
# SECURITY & MIDDLEWARE
# =================================================================
# CORS Configuration
CORS_ENABLED=true
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Rate Limiting (ThrottlerModule)
# Time window in seconds
THROTTLER_TTL=60
# Max requests per TTL
THROTTLER_LIMIT=100

# Cookie Configuration (HTTP-only cookies for authentication)
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false
# strict | lax | none
COOKIE_SAME_SITE=lax
# Optional: specify domain for cookies (e.g., .example.com) — leave empty for localhost
COOKIE_DOMAIN=

# =================================================================
# APPLICATION
# =================================================================
PORT=3000
APP_URL="http://localhost:3000"

# =================================================================
# FILE STORAGE
# =================================================================
# "local" — saves to public/uploads/ inside the container (default)
# "s3"    — uploads to AWS S3 (requires @aws-sdk/client-s3)
STORAGE_TYPE=local

# Required only when STORAGE_TYPE=s3:
# STORAGE_S3_BUCKET=my-app-uploads
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BASE_URL=https://my-app-uploads.s3.us-east-1.amazonaws.com
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# =================================================================
# EMAIL
# =================================================================
# Local dev: Mailhog catches all outgoing email — web UI at http://localhost:8025
# Use the Docker service name when app runs in Docker, localhost when running locally (npm run start:dev)
MAIL_HOST=mailhog
MAIL_PORT=1025
# Set to true in production (requires TLS/SSL on your SMTP server)
MAIL_SECURE=false
MAIL_FROM=noreply@example.com

# Frontend URL used in email links (verify-email, reset-password, etc.)
APP_URL=http://localhost:5173

# Production examples:
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_SECURE=false   (STARTTLS on 587; use true + port 465 for direct TLS)
# MAIL_FROM=noreply@yourapp.com

# =================================================================
# OPTIONAL: Error Tracking (Future Enhancement)
# =================================================================
# SENTRY_DSN=your-sentry-dsn
# SENTRY_ENVIRONMENT=production

# =================================================================
# DEVELOPMENT NOTES
# =================================================================
# 1. Copy this file to .env and fill in your values:
#    cp .env.example .env
#
# 2. NEVER commit .env to version control (already in .gitignore)
#
# 3. Generate secure secrets for production:
#    JWT_SECRET_KEY: openssl rand -base64 32
#    JWT_REFRESH_SECRET_KEY: openssl rand -base64 32
#
# 4. Change default admin password immediately in production
#
# 5. Enable COOKIE_SECURE=true in production (requires HTTPS)
#
# 6. For production CORS, specify exact frontend origins:
#    CORS_ORIGIN="https://app.example.com,https://admin.example.com"
